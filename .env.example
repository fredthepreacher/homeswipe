# ── API Server (Railway) ──────────────────────────────────
# Postgres connection string (Neon: https://neon.tech or Railway Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Server port (Railway sets this automatically)
PORT=3000

NODE_ENV=production

# ── Optional: seed admin credentials ─────────────────────
# If unset, defaults to admin@homesweep.com / Admin@HomeSweep1
# Override these in production.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password

# ── Frontend (Vercel) ─────────────────────────────────────
# Full URL of the Railway API, no trailing slash.
# Set this in the Vercel dashboard under Environment Variables.
# Leave unset locally — Vite dev proxy handles /api → localhost:3000.
VITE_API_URL=https://your-api-name.up.railway.app
