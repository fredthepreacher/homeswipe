# ── Clerk ─────────────────────────────────────────────────────────
# Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# IMPORTANT: for Supabase RLS to accept Clerk tokens you must also, in the
# Clerk dashboard, customize the session token to include a `role` claim with
# the value "authenticated". Without it every policy denies and reads come back
# empty. See https://supabase.com/docs/guides/auth/third-party/clerk

# ── Supabase ──────────────────────────────────────────────────────
# Two connection strings, and they are not interchangeable.
#
# App runtime — Supavisor TRANSACTION pooler, port 6543. Required on Vercel:
# each lambda instance holds its own pool, and direct connections exhaust
# Postgres' client limit under concurrency.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Schema migrations (`npm run db:push`) and drizzle/policies.sql — DIRECT
# connection, port 5432. DDL over the transaction pooler is unreliable.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: per-instance pool size. Keep small on serverless.
# PGPOOL_MAX=3
