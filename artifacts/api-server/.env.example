# ── Required ──────────────────────────────────────────────
# Postgres connection string (get this from Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret

# ── Optional ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
